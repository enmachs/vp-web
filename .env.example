# Copy to .env and fill in. Read by BOTH Next.js and the Keystone CLI.
# Resend keys live in .env.local — see .env.local.example.

DATABASE_URL=postgresql://user:password@localhost:5432/vp_web
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/vp_web
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/vp_web_shadow
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Image storage — Cloudflare R2 over the S3 API. See README.md#image-management.
S3_BUCKET_NAME=vp-web-images
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Where the browser loads images from: the bucket's r2.dev subdomain or a custom domain.
IMAGE_PUBLIC_URL=https://pub-<hash>.r2.dev
# Keeps local uploads out of the production namespace of the shared bucket.
S3_PATH_PREFIX=dev/
