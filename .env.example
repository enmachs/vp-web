# Copy the infrastructure vars into `.env` and the Resend vars into `.env.local`.
#
# The split is not cosmetic: Next.js loads `.env.local`, Keystone's CLI loads
# `.env`. Next reads `.env` too (at lower precedence), so anything both
# processes need belongs in `.env`.

# ─── .env — read by BOTH Next.js and the Keystone CLI ───────────────────────

# Neon pooled connection (the -pooler host). Used by the Next.js site on Vercel.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct/unpooled connection. Used by the admin container and by every
# `prisma migrate` command — DDL over a transaction pooler is unreliable.
# Deliberately NOT set on Vercel, so serverless falls through to the pooled URL.
DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Only needed for `prisma migrate dev`. Neon may refuse to create a shadow
# database; point this at a second Neon branch or use a local Postgres instead.
SHADOW_DATABASE_URL=

# Iron session secret for the Admin UI. Must be 32+ characters.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Vercel Blob. The token is only needed where uploads happen (the admin
# container) — the Next.js site only ever builds URLs from BLOB_BASE_URL.
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=https://<storeid>.public.blob.vercel-storage.com

# First-boot only, on the admin container. @keystone-6/auth v10 removed
# initFirstItem, so without these a fresh database gives you a sign-in page you
# cannot get past. Remove them once the admin user exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── .env.local — Next.js only (existing) ──────────────────────────────────
RESEND_API_KEY=
BUSINESS_EMAIL=
FROM_EMAIL=
