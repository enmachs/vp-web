// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String    @id @default(cuid())
  name                    String    @default("")
  email                   String    @unique @default("")
  password                String
  role                    Role?     @relation("User_role", fields: [roleId], references: [id])
  roleId                  String?   @map("role")
  passwordResetToken      String?
  passwordResetIssuedAt   DateTime?
  passwordResetRedeemedAt DateTime?

  @@index([roleId])
}

model Role {
  id                 String  @id @default(cuid())
  name               String  @default("")
  canSeeOtherPeople  Boolean @default(false)
  canEditOtherPeople Boolean @default(false)
  canManagePeople    Boolean @default(false)
  canManageRoles     Boolean @default(false)
  canAccessDashboard Boolean @default(false)
  canManageContent   Boolean @default(false)
  assignedTo         User[]  @relation("User_role")
}

model ServiceType {
  id           String              @id @default(cuid())
  key          String              @unique @default("")
  kind         ServiceTypeKindType @default(service)
  nameEs       String              @default("")
  nameEn       String              @default("")
  services     Service[]           @relation("Service_serviceType")
  galleryItems GalleryItem[]       @relation("GalleryItem_serviceType")
  sortOrder    Int                 @default(0)
  isPublished  Boolean             @default(true)
  createdAt    DateTime?           @default(now())
}

model Service {
  id            String       @id @default(cuid())
  slug          String       @unique @default("")
  titleEs       String       @default("")
  titleEn       String       @default("")
  bodyEs        String       @default("")
  bodyEn        String       @default("")
  tagsEs        Json?        @default("[]")
  tagsEn        Json?        @default("[]")
  serviceType   ServiceType? @relation("Service_serviceType", fields: [serviceTypeId], references: [id])
  serviceTypeId String?      @map("serviceType")
  sortOrder     Int          @default(0)
  isPublished   Boolean      @default(true)
  createdAt     DateTime?    @default(now())

  @@index([serviceTypeId])
}

model GalleryItem {
  id               String       @id @default(cuid())
  image_id         String?
  image_filesize   Int?
  image_width      Int?
  image_height     Int?
  image_extension  String?
  labelEs          String       @default("")
  labelEn          String       @default("")
  takenOn          DateTime?
  placeholderColor String       @default("#8a8a8a")
  serviceType      ServiceType? @relation("GalleryItem_serviceType", fields: [serviceTypeId], references: [id])
  serviceTypeId    String?      @map("serviceType")
  sortOrder        Int          @default(0)
  isPublished      Boolean      @default(true)
  createdAt        DateTime?    @default(now())

  @@index([serviceTypeId])
}

model ContactInfo {
  id        Int    @id
  email     String @default("")
  phone     String @default("")
  whatsapp  String @default("")
  addressEs String @default("")
  addressEn String @default("")
  mapsUrl   String @default("")
  hoursEs   String @default("")
  hoursEn   String @default("")
}

model SocialLink {
  id          String                 @id @default(cuid())
  platform    SocialLinkPlatformType
  label       String                 @default("")
  url         String                 @default("")
  handle      String                 @default("")
  sortOrder   Int                    @default(0)
  isPublished Boolean                @default(true)
  createdAt   DateTime?              @default(now())
}

model Review {
  id          String    @id @default(cuid())
  quoteEs     String    @default("")
  quoteEn     String    @default("")
  authorName  String    @default("")
  initials    String    @default("")
  contextEs   String    @default("")
  contextEn   String    @default("")
  rating      Int       @default(5)
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime? @default(now())
}

enum ServiceTypeKindType {
  service
  showcase
}

enum SocialLinkPlatformType {
  instagram
  facebook
  tiktok
  youtube
  x
}
